# control_msgs/FollowJointTrajectory with the arm gains carried in the goal
# (<arm>/follow_joint_trajectory_gains). The gains apply to this goal only
# and end with it. Empty gains = the arm's configured gains.
trajectory_msgs/JointTrajectory trajectory
ccros_msgs/ArmGains gains
---
int32 error_code
int32 SUCCESSFUL = 0
int32 INVALID_GOAL = -1
int32 INVALID_JOINTS = -2
int32 OLD_HEADER_TIMESTAMP = -3
int32 PATH_TOLERANCE_VIOLATED = -4
int32 GOAL_TOLERANCE_VIOLATED = -5
string error_string
---
std_msgs/Header header
string[] joint_names
trajectory_msgs/JointTrajectoryPoint desired
trajectory_msgs/JointTrajectoryPoint actual
trajectory_msgs/JointTrajectoryPoint error
